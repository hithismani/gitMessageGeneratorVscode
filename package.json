{
  "name": "gitmessagegenerator",
  "displayName": "gitMessageGenerator",
  "description": "AI-powered git commit messages via Chutes.ai or OpenCode Zen — one click in Source Control",
  "version": "0.3.1",
  "publisher": "businessaddonscom",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/businessaddons/gitMessageGeneratorVscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Machine Learning"
  ],
  "keywords": [
    "git",
    "commit",
    "ai",
    "chutes",
    "opencode",
    "conventional-commits",
    "deepseek",
    "qwen",
    "llama",
    "openai"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitmessagegenerator.generateCommitMessage",
        "title": "Generate Commit Message",
        "icon": "$(sparkle)",
        "category": "gitMessageGenerator"
      },
      {
        "command": "gitmessagegenerator.selectModel",
        "title": "Select Model",
        "icon": "$(server)",
        "category": "gitMessageGenerator"
      },
      {
        "command": "gitmessagegenerator.selectStyle",
        "title": "Select Commit Style",
        "icon": "$(symbol-color)",
        "category": "gitMessageGenerator"
      },
      {
        "command": "gitmessagegenerator.setApiKey",
        "title": "Set API Key",
        "icon": "$(key)",
        "category": "gitMessageGenerator"
      },
      {
        "command": "gitmessagegenerator.openSettings",
        "title": "Open Settings",
        "icon": "$(gear)",
        "category": "gitMessageGenerator"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitmessagegenerator.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        },
        {
          "command": "gitmessagegenerator.selectModel",
          "group": "1_commit_pilot",
          "when": "scmProvider == git"
        },
        {
          "command": "gitmessagegenerator.selectStyle",
          "group": "1_commit_pilot",
          "when": "scmProvider == git"
        },
        {
          "command": "gitmessagegenerator.openSettings",
          "group": "1_commit_pilot",
          "when": "scmProvider == git"
        },
        {
          "command": "gitmessagegenerator.setApiKey",
          "group": "1_commit_pilot",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "gitMessageGenerator",
      "properties": {
        "gitMessageGenerator.provider": {
          "type": "string",
          "default": "chutes",
          "enum": [
            "chutes",
            "opencode-zen",
            "opencode-go"
          ],
          "enumDescriptions": [
            "Chutes.ai — community-hosted open-source models",
            "OpenCode Zen — curated models via opencode.ai",
            "OpenCode Go — low-cost subscription tier via opencode.ai"
          ],
          "description": "AI provider to use for commit message generation",
          "order": 0
        },
        "gitMessageGenerator.chutesApiKey": {
          "type": "string",
          "default": "",
          "description": "Chutes.ai API key — stored securely via VS Code SecretStorage. Run gitMessageGenerator: Set API Key instead of entering here.",
          "order": 1
        },
        "gitMessageGenerator.opencodeZenKey": {
          "type": "string",
          "default": "",
          "description": "OpenCode Zen / Go API key — stored securely via VS Code SecretStorage. Run gitMessageGenerator: Set API Key instead of entering here.",
          "order": 2
        },
        "gitMessageGenerator.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model ID to use. Run **gitMessageGenerator: Select Model** from the command palette to browse available models live.",
          "order": 3
        },
        "gitMessageGenerator.commitStyle": {
          "type": "string",
          "default": "conventional",
          "markdownDescription": "Commit message style. Built-in: `conventional`, `imperative`. Or the name of a style defined in `#gitMessageGenerator.customStyles#`.",
          "order": 4
        },
        "gitMessageGenerator.customStyles": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Custom commit message styles. Key = style name, value = system prompt. Set at workspace level for per-project defaults.",
          "order": 5
        },
        "gitMessageGenerator.temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 2,
          "description": "Generation temperature (0-2)",
          "order": 6
        },
        "gitMessageGenerator.maxTokens": {
          "type": "number",
          "default": 512,
          "minimum": 64,
          "maximum": 2048,
          "description": "Max response tokens (64-2048)",
          "order": 7
        },
        "gitMessageGenerator.autoFallback": {
          "type": "boolean",
          "default": true,
          "description": "Automatically switch to another available model if the configured one fails",
          "order": 8
        },
        "gitMessageGenerator.customPrompt": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "description": "Custom system prompt override. If set, replaces the default conventional commits prompt entirely.",
          "order": 9
        },
        "gitMessageGenerator.maxDiffLength": {
          "type": "number",
          "default": 4000,
          "minimum": 500,
          "maximum": 40000,
          "description": "Max diff characters sent per file to the LLM",
          "order": 10
        },
        "gitMessageGenerator.recentCommitCount": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 20,
          "description": "Number of recent commits to include as context",
          "order": 11
        },
        "gitMessageGenerator.lockFiles": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional lock files to skip (built-in list already covers common ones)",
          "order": 12
        },
        "gitMessageGenerator.maxRetries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "Max API call retries (transient errors only — auth/not-found errors never retry)",
          "order": 13
        },
        "gitMessageGenerator.retryDelayMs": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 10000,
          "description": "Base delay between retries in ms (increases with each attempt)",
          "order": 14
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  }
}
