{
  "name": "chutes-commit",
  "displayName": "Chutes Commit",
  "description": "AI-powered commit messages using any model on Chutes.ai — one click in the Source Control panel",
  "version": "0.1.0",
  "publisher": "hithismani",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hithismani/chutes-commit"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "git",
    "commit",
    "ai",
    "chutes",
    "conventional-commits",
    "deepseek",
    "llama",
    "qwen"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "chutes-commit.generateCommitMessage",
        "title": "Generate Commit Message using Chutes.ai",
        "icon": "$(sparkle)",
        "category": "Chutes Commit"
      },
      {
        "command": "chutes-commit.selectModel",
        "title": "Select Model",
        "icon": "$(server)",
        "category": "Chutes Commit"
      },
      {
        "command": "chutes-commit.openSettings",
        "title": "Open Settings",
        "icon": "$(gear)",
        "category": "Chutes Commit"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "chutes-commit.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        },
        {
          "command": "chutes-commit.selectModel",
          "group": "1_commit_pilot",
          "when": "scmProvider == git"
        },
        {
          "command": "chutes-commit.openSettings",
          "group": "1_commit_pilot",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "Chutes Commit",
      "properties": {
        "chutesCommit.apiKey": {
          "type": "string",
          "default": "",
          "description": "Chutes.ai API key (cpk_...)",
          "order": 0
        },
        "chutesCommit.model": {
          "type": "string",
          "default": "Qwen/Qwen3-32B-TEE",
          "markdownDescription": "Model ID to use on Chutes.ai. Run **Chutes Commit: Select Model** from the command palette to browse all available models live.",
          "order": 1
        },
        "chutesCommit.temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 2,
          "description": "Generation temperature (0-2)",
          "order": 2
        },
        "chutesCommit.maxTokens": {
          "type": "number",
          "default": 512,
          "minimum": 64,
          "maximum": 2048,
          "description": "Max response tokens (64-2048)",
          "order": 3
        },
        "chutesCommit.customPrompt": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "description": "Custom system prompt override. If set, replaces the default conventional commits prompt entirely.",
          "order": 4
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
